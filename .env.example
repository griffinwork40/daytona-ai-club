# Daytona Beach AI Club environment variables.
# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git. Never commit real keys.
#
# Every value below is intentionally blank. With the Resend values
# missing, both forms tell visitors that signups are not open yet
# instead of pretending to succeed.

# --- Resend (https://resend.com) ---------------------------------

# API key, server side only. Needed by both forms.
RESEND_API_KEY=

# ID of the Resend segment that new members are added to.
# Needed by the join form.
# Used as: resend.contacts.create({ segments: [{ id: RESEND_SEGMENT_ID }] })
RESEND_SEGMENT_ID=

# Sender for talk proposal emails. Must be on a domain verified in
# Resend. Accepts "Display Name <address>" or a plain address.
# Needed by the speak form.
RESEND_FROM_ADDRESS=

# Where talk proposals are delivered. Needed by the speak form.
ORGANIZER_EMAIL=

# --- Site --------------------------------------------------------

# Canonical origin for metadata, the sitemap, and share images,
# with no trailing slash. Optional: falls back to the Vercel
# production URL, then to http://localhost:3000.
SITE_URL=
